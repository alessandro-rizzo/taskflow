  "threat_model": {
    "hostile": [
      "compiled-project-planner",
      "planner-stdout",
      "planner-stderr",
      "planner-emitted-json",
      "planner-exit-status",
      "planner-claimed-policy-identity"
    ],
    "trusted": [
      "outer-supervisor",
      "immutable-view-builder",
      "host-kernel",
      "exercised-isolation-mechanism",
      "limit-setting-launcher",
      "independent-python-validator",
      "verified-phase-a-contract-and-policy"
