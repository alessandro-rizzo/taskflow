    "structural_oracle_not_authority": "fixtures/t1-plan-conformance",
    "real_secret_allowed": false,
    "public_or_unrelated_network_target_allowed": false,
    "external_effect_allowed": false
  },
  "planner_input_contract": {
    "selected_source_view": {
      "single": true,
      "digest_verified_before_launch": true,
      "immutable_for_invocation": true,
      "writable_by_planner": false
    },
    "declared_inputs": {
      "single_json_document": true,
      "digest_verified_before_launch": true,
      "writable_by_planner": false
    },
    "environment": {
      "inherit_parent": false,
      "fixed_minimal_allowlist": [
        "PATH",
        "TMPDIR",
        "LANG",
        "LC_ALL"
      ],
      "path_value": "/usr/bin:/bin",
      "locale_value": "C",
      "home_present": false,
      "daemon_provider_secret_canaries_present": false
    },
    "writable_paths": "one-invocation-private-scratch",
    "runtime_or_credential_sockets": [],
    "daemon_provider_or_secret_handles": [],
    "parent_synthetic_canaries": [
      "TASKFLOW_E03_SYNTHETIC_DAEMON_TOKEN",
      "TASKFLOW_E03_SYNTHETIC_PROVIDER_TOKEN",
      "TASKFLOW_E03_SYNTHETIC_SECRET_VALUE"
    ]
  },
  "safe_attack_boundary": {
    "filesystem_targets": "experiment-owned temporary root only",
    "network_targets": "still-open harness-owned TCP and Unix listeners only",
    "process_targets": "one experiment-built descendant only",
    "secret_material": "obviously synthetic E03 markers only",
    "marker_encodings_scanned": [
      "raw",
      "hex-lowercase",
      "base64-standard"
    ],
    "image_pull_allowed": false,
    "vm_creation_or_start_allowed": false,
    "host_credential_use_allowed": false
  },
  "hard_limits": {
    "per_attempt_wall_seconds_maximum": 2,
    "candidate_suite_wall_seconds_maximum": 30,
    "cpu_seconds_hard": 1,
    "address_space_bytes_hard": 268435456,
    "file_descriptors_hard": 64,
    "combined_output_bytes_maximum": 1048576,
    "accepted_w1_plan_bytes_maximum": 1048576,
    "descendant_cleanup_seconds_maximum": 1,
    "processes_hard_when_supported": 32,
    "unsupported_hard_limit_result": "trusted_local_limitation"
  },
  "hard_gates": {
    "selected_source_digest_changes": 0,
    "outside_canary_changes": 0,
    "planner_visible_daemon_provider_secret_canary_bytes": 0,
    "retained_evidence_canary_or_encoded_canary_bytes": 0,
    "unauthorized_listener_accepts": 0,
    "surviving_descendants": 0,
    "post_exit_marker_writes": 0,
    "accepted_unauthorized_plans": 0,
    "allowed_attack_outcomes": [
      "blocked",
      "bounded",
      "trusted_local_limitation"
    ],
    "trusted_local_limitation_qualifies_for_untrusted_agent_planning": false,
    "per_attempt_required_fields": [
      "format_version",
      "candidate",
      "attempt_id",
      "case_id",
      "outcome",
      "duration_seconds",
      "mechanism_identity",
      "policy_digest",
      "applied_limits",
      "denial_reason",
      "leak_scan"
    ]
  },
  "candidates": [
    {
      "id": "native",
      "order": 1,
      "execution": "compiled-project-code",
      "requirements": [
        "fresh-process-group",
        "trusted-limit-setting-launcher",
        "minimal-noninherited-environment",
        "capped-stdout-stderr",
        "wall-deadline-and-kill-group",
        "deny-first-sandbox-exec-profile",
        "policy-template-digest-in-evidence"
      ],
      "nested-sandbox-denial_result": "unavailable",
      "unsupported_security_control_result": "trusted_local_limitation"
    },
    {
      "id": "pooled-container",
      "order": 2,
      "execution": "compiled-project-code",
      "requirements": [
        "prestarted-local-scratch-image",
        "no-network",
        "read-only-root",
        "all-capabilities-dropped",
        "no-new-privileges",
        "no-host-runtime-or-credential-sockets",
        "read-only-input-mounts",
        "tmpfs-scratch",
        "hard-cpu-memory-pid-fd-limits",
        "fresh-exec-per-sample"
      ],
      "remote_image_pull_allowed": false,
      "daemon_unreachable_result": "unavailable"
    },
    {
      "id": "helper-vm",
      "order": 3,
      "execution": "compiled-project-code",
      "requirements": [
        "already-authorized-dedicated-endpoint",
        "read-only-input-transfer",
        "network-denial",
        "resource-quotas",
        "descendant-cleanup",
        "guest-image-and-policy-identity"
      ],
      "implicit_create_or_start_allowed": false,
      "missing_endpoint_result": "unavailable"
    },
    {
      "id": "static-descriptor",
      "order": 4,
      "execution": "no-project-code",
      "requirements": [
        "hash-bound-e01-schema",
        "hash-bound-e02-canonical-w1-plan",
        "declared-input-selection-only",
        "independent-policy-validation"
      ],
      "declared_limitation": "arbitrary-dynamic-graph-construction-unavailable"
    }
  ],
  "independent_validator": {
    "language": "python3-standard-library",
    "may_import_planner_or_e02_go_implementation": false,
    "trusted_policy_path": "experiments/e03-planner-trust/policies/untrusted-plan-policy.json",
    "planner_supplied_policy_is_authoritative": false,
    "known_good": "experiments/e02-plan-ir/evidence/raw/plans/w1.json",
    "must_accept_known_good": true,
    "must_reject": [
      "duplicate-json-members",
      "trailing-data",
      "invalid-utf8",
      "missing-or-unknown-version",
      "unknown-fields",
      "document-size-depth-or-count-over-limit",
      "resource-request-over-limit",
      "absolute-or-parent-traversing-path-bearing-values",
      "target-outside-allowlist",
      "unapproved-service-or-network-route",
      "unapproved-secret-capability",
      "unapproved-effect",
      "dangling-effect-target",
      "planner-policy-or-approval-fields"
    ],
    "stable_semantic_path_diagnostics": true,
    "t1_conformance_is_additional_not_authoritative": true
  },
  "performance_gate": {
    "metric": "warm-w1-planning-through-independent-validation",
    "candidate_order": [
      "native",
      "pooled-container",
      "helper-vm",
      "static-descriptor"
    ],
    "samples_per_exercised_candidate": 30,
    "state": "warm",
    "driver": "prebuilt",
    "invocation": "fresh-per-sample",
    "concurrent_measurement_allowed": false,
    "timed_boundary_start": "immutable-selected-source-and-declared-inputs-ready",
    "timed_boundary_end": "w1-plan-independently-validated-and-accepted",
    "pool_creation_in_timed_boundary": false,
    "per_invocation_pool_exec_capture_and_validation_in_timed_boundary": true,
    "p95_seconds_exclusive": 0.25,
    "statistics": "fixtures/t1-benchmark-harness taskflow-t1-benchmark/v2",
    "correctness_gate_must_pass_before_sampling": true
  },
  "rerun_rules": {
    "failed_or_invalid_set": "retain the complete set, document cause and exact mechanical correction, then rerun from sample one",
    "maximum_corrected_reruns_per_candidate": 1,
    "individual_sample_replacement_allowed": false,
    "threshold_or_branch_change_after_results_allowed": false,
    "discretionary_reruns_allowed": false,
    "unavailable_candidate_record_required": true
  },
  "decision_branches": {
    "priority": [
      "stop-or-narrow-on-correctness",
      "native",
      "pooled-container",
      "helper-vm",
      "static-descriptor",
      "stop-or-narrow-on-latency"
    ],
    "stop-or-narrow-on-correctness": "Select when the validator leaks authority, no approach bounds every malicious case, or static descriptors cannot represent the required W1 plan.",
    "native": "Select for untrusted local and agent planning only when every hard gate passes without a security-relevant trusted-local limitation and warm p95 is below 0.250 seconds.",
    "pooled-container": "Select when native does not qualify and an actually exercised pooled container passes every hard gate and warm p95 below 0.250 seconds.",
    "helper-vm": "Select when native and container do not qualify and an actually exercised approved helper VM passes every hard gate and warm p95 below 0.250 seconds.",
    "static-descriptor": "Select for untrusted runs when executable candidates fail, are unavailable, or miss latency and the no-project-code descriptor passes validation and warm p95; an explicit trusted-local executable mode may remain with disclosed limitations.",
    "stop-or-narrow-on-latency": "Select when every safe candidate, including static descriptors, is incompatible with the W1 planning budget.",
    "correctness_and_secret_leakage_precede_latency_or_availability": true
  },
  "catalogue_contract": {
    "path": "experiments/e03-planner-trust/attacks.json",
