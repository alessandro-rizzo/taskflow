{
  "schema_version": "taskflow-e02-experiment-protocol/v1",
  "roadmap_id": "E02",
  "task_id": "TF-003.08",
  "status": "phase-a-contract-only",
  "base_revision": "834ee0a95eef05a2a4e434bf9095826ee93a8cc5",
  "question": "Can authored operations lower to deterministic language-neutral plan JSON sufficient for independent validation, display, identity, and resume explanation?",
  "disposable_boundaries": {
    "all_e02_formats_apis_and_implementations_are_experimental": true,
    "production_go_module_selected": false,
    "public_package_selected": false,
    "daemon_transport_selected": false,
    "compatibility_promise": false,
    "prototype_import_allowed": false,
    "goldens_may_be_generation_inputs": false
  },
  "formats": {
    "plan_format_version": "t1-plan-conformance-plan-v2",
    "resume_diff_format_version": "e02-resume-diff-v1",
    "benchmark_schema_version": "taskflow-t1-benchmark/v2",
    "digest": "sha256-lowercase-hex-over-canonical-bytes"
  },
  "plan_grammar": {
    "json_values_only": true,
    "forbidden_runtime_values": [
      "function",
      "interface",
      "pointer",
      "closure",
      "executable-callback",
      "secret-value",
      "provider-handle",
      "worker-handle",
      "ambient-host-value"
    ],
    "identifier_pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
    "integers": {
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807,
      "fraction_exponent_plus_and_negative_zero_allowed": false
    },
    "duplicate_object_members_allowed": false,
    "unknown_fields_allowed": false,
    "objects": {
      "plan": {
        "required": ["document_kind", "format_version", "fixture_id", "fixture_version", "status", "nodes", "artifacts", "services", "secrets", "effects"],
        "allowed": ["document_kind", "format_version", "fixture_id", "fixture_version", "status", "nodes", "artifacts", "services", "secrets", "effects"]
      },
      "node": {
        "required": ["id", "needs", "consumes", "produces", "planning_condition", "outcome_condition", "resources", "execution_profile", "cache_policy"],
        "allowed": ["id", "needs", "consumes", "produces", "planning_condition", "outcome_condition", "resources", "execution_profile", "cache_policy"]
      },
      "artifact": {
        "required": ["id", "type", "optional"],
        "allowed": ["id", "type", "optional"]
      },
      "service": {
        "required": ["id", "name", "route"],
        "allowed": ["id", "name", "route"]
      },
      "secret": {
        "required": ["id", "capability", "resolved_by"],
        "allowed": ["id", "capability", "resolved_by"],
        "resolved_by_value": "daemon",
        "secret_value_field_allowed": false
      },
      "effect": {
        "required": ["id", "kind", "target", "idempotency_key", "authorized_actor"],
        "allowed": ["id", "kind", "target", "idempotency_key", "authorized_actor"]
      },
      "planning_condition": {
        "variants": {
          "always": ["type"],
          "changed-paths": ["type", "patterns", "exclude_patterns"]
        },
        "required_by_variant": {
          "always": ["type"],
          "changed-paths": ["type", "patterns"]
        }
      },
      "outcome_condition": {
        "variants": {
          "always": ["type"],
          "all-upstream-pass": ["type"],
          "conditional": ["type"]
        }
      },
      "resources": {
        "required": ["cpu_millicores", "memory_mib"],
        "allowed": ["cpu_millicores", "memory_mib"],
        "nonnegative_integers": true
      },
      "execution_profile": {
        "required": ["os", "toolchain"],
        "allowed": ["os", "toolchain", "profile_digest", "profile_id", "target_role"]
      },
      "cache_policy": {
        "variants": {
          "none": ["mode"],
          "content-addressed": ["mode", "key_inputs"]
        },
        "required_by_variant": {
          "none": ["mode"],
          "content-addressed": ["mode", "key_inputs"]
        }
      }
    }
  },
  "canonical_json": {
    "encoding": "utf-8",
    "bom": false,
    "whitespace": "none",
    "trailing_newline": false,
    "object_member_order": "lexicographic-utf8-key-bytes",
    "string_rule": "unicode-scalars-shortest-json-escape-lowercase-u00xx-otherwise-raw-utf8-no-html-escape",
    "integer_rule": "signed-int64-shortest-base10-no-plus-fraction-exponent-leading-zero-or-negative-zero",
    "literal_rule": "lowercase-true-false-null",
    "arrays_ordered_by_default": true,
    "set_like_paths": [
      {"path": "$.nodes", "element": "object", "unique_by": "id", "order": "utf8-id-bytes"},
      {"path": "$.artifacts", "element": "object", "unique_by": "id", "order": "utf8-id-bytes"},
      {"path": "$.services", "element": "object", "unique_by": "id", "order": "utf8-id-bytes"},
      {"path": "$.secrets", "element": "object", "unique_by": "id", "order": "utf8-id-bytes"},
      {"path": "$.effects", "element": "object", "unique_by": "id", "order": "utf8-id-bytes"},
      {"path": "$.nodes[*].needs", "element": "string", "unique_by": "value", "order": "utf8-value-bytes"},
      {"path": "$.nodes[*].consumes", "element": "string", "unique_by": "value", "order": "utf8-value-bytes"},
      {"path": "$.nodes[*].produces", "element": "string", "unique_by": "value", "order": "utf8-value-bytes"},
      {"path": "$.nodes[*].planning_condition.patterns", "element": "string", "unique_by": "value", "order": "utf8-value-bytes"},
      {"path": "$.nodes[*].planning_condition.exclude_patterns", "element": "string", "unique_by": "value", "order": "utf8-value-bytes"},
      {"path": "$.nodes[*].cache_policy.key_inputs", "element": "string", "unique_by": "value", "order": "utf8-value-bytes"}
    ],
    "open_ended_key_name_heuristic_allowed": false
  },
  "resume_diff": {
    "required_fields": ["format_version", "compatible", "differences"],
    "difference_fields": ["path", "classification", "before", "after"],
    "path_style": "jsonpath-with-semantic-id-selectors",
    "array_indexes_allowed_in_paths": false,
    "classification": "structural-incompatible",
    "sort_differences_by": "utf8-path-bytes"
  },
  "scope": {
    "phase_a_allowed_files": [
      "Taskfile.yml",
      "experiment-contract.md",
