      {"id": "t1-plan-w3", "role": "post-generation-comparison-only", "path": "fixtures/t1-plan-conformance/goldens/plan/w3-isolated-native-mobile-stack.plan.json", "sha256": "f36e312c944a534d5edfcfdab0fda0f536042960b1b605b8ae700a77af8411d1"},
      {"id": "t1-plan-synthetic", "role": "post-generation-comparison-only", "path": "fixtures/t1-plan-conformance/goldens/plan/synthetic-full-coverage.plan.json", "sha256": "90dc0a7b2b8cddd545099cbeae754c5e763d69ea02459f682cdd2053feb51bb6"}
    ],
    "fixture_boundaries": {
      "w1": "read-only adapter over E01 Candidate B ComposeW1 trace",
      "w2": "E02-local disposable typed concrete graph matching T1 after emission",
      "w3": "E02-local disposable typed concrete graph matching T1 after emission",
      "synthetic": "E02-local disposable typed full-coverage graph matching T1 after emission"
    }
  },
  "hard_gates": {
    "fixtures": ["w1", "w2", "w3", "synthetic"],
    "t1_validation_violations": 0,
    "t1_structural_differences": 0,
    "fresh_processes_per_fixture": 20,
    "distinct_canonical_byte_sequences_per_fixture": 1,
    "distinct_digests_per_fixture": 1,
    "go_python_canonical_byte_differences": 0,
    "go_python_digest_differences": 0,
    "reorder_probe_minimum_elements_per_set_like_path": 2,
    "reorder_digest_differences": 0,
    "authority_counters": {"worker_acquisitions": 0, "provider_calls": 0, "secret_resolutions": 0},
    "untouched_sentinels": ["E02_OPERATION_BODY_SENTINEL", "E02_FILE_WRITE_SENTINEL"],
    "synthetic_required_concepts": ["typed-artifact", "optional-output", "planning-condition", "outcome-condition", "resources", "execution-profile", "cache-policy", "secret-capability-reference", "endpoint", "effect"],
    "shape_probe": {"argument": "platform", "accepted_values": ["ios", "android"], "other_values_rejected": true, "complete_finite_graph": true, "serialized_callback": false},
    "unknown_field_rejections": [
      {"case": "root", "expected_path": "$.unexpected"},
      {"case": "nested-node-test", "expected_path": "$.nodes[id=test].unexpected"}
    ],
    "incompatible_version_rejection_path": "$.format_version"
  },
  "meaningful_mutations": [
    {"id": "planning-condition", "fixture": "w1", "target": "lint", "field": "planning_condition.patterns", "before": ["**/*.go"], "after": ["**/*.go", "**/*.mod"], "expected_paths": ["$.nodes[id=lint].planning_condition.patterns"]},
    {"id": "execution-profile", "fixture": "w1", "target": "test", "field": "execution_profile.toolchain", "before": "go1.25.12", "after": "go1.25.13", "expected_paths": ["$.nodes[id=test].execution_profile.toolchain"]},
    {"id": "output-type", "fixture": "w1", "target": "test-report", "field": "type", "before": "Report[GoTests]", "after": "Report[UnitTests]", "expected_paths": ["$.artifacts[id=test-report].type"]},
    {"id": "output-optionality", "fixture": "w1", "target": "test-report", "field": "optional", "before": false, "after": true, "expected_paths": ["$.artifacts[id=test-report].optional"]}
  ],
  "performance_gates": {
    "execution_order": ["w1-plan", "large-generation-canonicalization", "large-reader-validation-digest"],
    "concurrent_measurement_allowed": false,
    "w1_plan": {"samples": 30, "state": "warm", "driver": "prebuilt", "process": "fresh-per-sample", "p95_seconds_exclusive": 0.25},
    "large_graph": {"nodes": 10000, "deterministic": true, "canonical_bytes_maximum_inclusive": 16777216},
    "large_generation_and_canonicalization": {"samples": 15, "state": "warm", "process": "fresh-per-sample", "p95_seconds_exclusive": 2.0},
    "large_reader_validation_and_digest": {"samples": 15, "state": "warm", "process": "fresh-per-sample", "p95_seconds_exclusive": 2.0},
    "statistics": "fixtures/t1-benchmark-harness taskflow-t1-benchmark/v2 ComputeStatistics",
    "required_metadata": ["source_revision", "timestamp_utc", "cpu", "cores", "ram_gib", "os_name", "os_version", "os_build", "arch", "go_version", "python_version", "preparation_command", "timed_command", "cache_dimensions", "raw_samples", "sample_count", "median", "p95", "byte_count"]
  },
  "rerun_rules": {
    "failed_set": "retain the complete failed set, document cause and exact correction, then rerun the complete set from sample one",
    "maximum_corrected_reruns_per_set": 1,
    "individual_sample_replacement_allowed": false,
    "threshold_or_rule_change_after_results_allowed": false,
    "other_discretionary_reruns_allowed": false
  },
  "decision_branches": {
    "priority": ["stop-revise-semantics", "bounded-dynamic-expansion", "pivot-encoding", "continue-canonical-json"],
    "continue-canonical-json": "every hard, safety, determinism, scale, and performance gate passes",
    "pivot-encoding": "cross-language bytes, reorder invariance, strict validation, size, or latency fails, or correctness needs an open-ended key-name heuristic; retain failure and compare schema-first Protobuf or canonical CBOR with JSON diagnostics",
    "bounded-dynamic-expansion": "representative argument-dependent graph cannot become a complete finite plan; retain failure and prototype explicit limits without daemon callbacks into project code",
    "stop-revise-semantics": "language neutrality requires erasing typed artifact, optional, endpoint, or effect distinctions; revise E01 and value semantics before T2",
    "production_protocol_selected_before_gate_1": false
  },
