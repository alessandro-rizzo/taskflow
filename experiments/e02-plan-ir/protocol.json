      {"id": "t1-plan-w1", "role": "post-generation-comparison-only", "path": "fixtures/t1-plan-conformance/goldens/plan/w1-fast-project-check.plan.json", "sha256": "3c50f41566609e70a9da3f6e2c10dc49f829c5990320122480c0af5d73b036c9"},
