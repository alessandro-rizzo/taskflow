      "candidate-json/",
      "reader/",
      "mutations/",
      "evidence/",
      "benchmarks/"
    ],
    "scope_hashes_path": "experiments/e02-plan-ir/scope-hashes.json",
    "bindings": [
      {"id": "e01-candidate-b-go-module", "role": "accepted-e01-w1-import-surface", "path": "experiments/e01-authoring-schema/candidates/b-generated-go/go.mod", "sha256": "0d1be68ebb3aeafda772cc4193f03aed856628147192b1a306273cf36e055e7f"},
      {"id": "e01-candidate-b-project", "role": "accepted-e01-w1-source", "path": "experiments/e01-authoring-schema/candidates/b-generated-go/project.go", "sha256": "e759b5b113a99a9eecce901e2f66b0c133dae417d3380dff1eea5f1a786f9c96"},
      {"id": "e01-candidate-b-runtime", "role": "accepted-e01-w1-trace-runtime", "path": "experiments/e01-authoring-schema/candidates/b-generated-go/runtime.go", "sha256": "c2123b9a3a14d64b5ab0e1073c958c37293c0732130da5568637cb455263a429"},
      {"id": "e01-candidate-b-generator", "role": "accepted-e01-package-import-closure", "path": "experiments/e01-authoring-schema/candidates/b-generated-go/generator.go", "sha256": "9daefcb8ed194869d6eafa75d3669d543bc834b5db3de6066d4b3d95aa69c0d9"},
